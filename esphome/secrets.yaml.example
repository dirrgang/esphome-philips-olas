# Copy to secrets.yaml and use the actual credentials/keys from your existing
# ESPHome device. Never commit secrets.yaml.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
olas_rf_gateway__encryption_key: "REPLACE_WITH_YOUR_EXISTING_32_BYTE_BASE64_API_KEY"
olas_rf_gateway__ap_password: "REPLACE_WITH_YOUR_EXISTING_FALLBACK_AP_PASSWORD"
# The following two values came from the observed 2026-10-30 test unit.
# They are RF identifiers, not cryptographic secrets; redact when publishing
# real device-specific captures if you prefer.
olas_fan_id: "0xAA8C03"
olas_check_xor: "0x25"
