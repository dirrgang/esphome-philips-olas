# Copy to secrets.yaml and use the actual credentials/keys from your existing
# ESPHome device. Never commit secrets.yaml.
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
api_encryption_key: "REPLACE_WITH_YOUR_32_BYTE_BASE64_API_KEY"
fallback_ap_password: "REPLACE_WITH_YOUR_FALLBACK_AP_PASSWORD"
# Disabled sentinels for discovery only. Capture your own remote's values
# before enabling control; these are not usable pairing parameters.
olas_fan_id: "0x000000"
olas_check_xor: "0x00"
